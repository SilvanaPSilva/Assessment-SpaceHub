@endpoint = http://localhost:3000/api/v1/bookings
//@newHub = 6acf6fc202108ed6d39cdf1d
@hubId = {{postHubForABooking.response.body._id}}
@newbooking = {{postABooking.response.body._id}}

###
# POST | >>> FIRST <<< CREATE AN HUB 
# @name postHubForABooking
POST http://localhost:3000/api/v1/hubs HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "roomNumber": 1,
  "capacity": "3-5",
  "equipment": ["TV"]
}

###
# 1.POST request with correct data.
# @name postABooking
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "hubId": "{{hubId}}",
  "checking": "2026-11-01",
  "checkout": "2026-11-04"
}

###
# 2.POST request which fails validation.
# @name postFakeBooking
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "hubId": "{{hubId}}",
  "checking": "01-11-2026",
  "checkout": "2026-11-04"
}

### 
# 3.GET request on the set of resources.
GET {{endpoint}} HTTP/1.1

###
#4.	GET request on an individual resource with succeeds.
GET {{endpoint}}/{{newbooking}} HTTP/1.1

###
# 5. GET request on an individual resource which fails.
GET  {{endpoint}}/6acab644a37aacc98fa475c8 HTTP/1.1

###
#6.	PUT request on an individual resource which succeeds.
PUT  {{endpoint}}/{{newbooking}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "hubId": "{{hubId}}",
  "checking": "2026-11-01",
  "checkout": "2026-11-08"
}

###
# 7. PUT request on an individual resource which fails as the resource cannot be found.
PUT  {{endpoint}}/6acf6fc202108ed6d39cdf1e HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "hubId": "{{hubId}}",
  "checking": "2026-11-04",
  "checkout": "2026-11-08"
}

###
# 8.	PUT request on an individual resource which fails as the data is not valid.
PUT  {{endpoint}}/{{newbooking}} HTTP/1.1
content-type: application/json
x-api-key: blahblah

{
  "hubId": "{{hubId}}",
  "checking": "01-11-2026",
  "checkout": "2026-11-04"
}

###
#9.	DELETE request on an individual resource which succeeds.
DELETE  {{endpoint}}/{{newbooking}} HTTP/1.1

###
#10.	DELETE request on an individual resource which fails.
DELETE  {{endpoint}}/6acab644a37aacc98fa475c8 HTTP/1.1